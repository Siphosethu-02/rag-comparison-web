# Copy to .env.local and fill in. On Vercel, add these as Environment Variables.

# --- Firebase (service account) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com
# Paste the private key with literal \n for newlines, wrapped in quotes:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- LLM backends ---
GROQ_API_KEY=gsk_...                       # console.groq.com (base model + judge)
HF_TOKEN=hf_...                            # huggingface.co (embeddings + fine-tuned model)
FINETUNED_MODEL=your-username/your-ft-model  # your fine-tuned model on the HF Hub

# --- Reliability (optional) ---
FINETUNED_FALLBACK=true   # if the fine-tuned model errors, show the base model (labelled) instead of an error
EVAL_LIMIT=5              # max test questions per Evaluate run (keeps it under Vercel's function timeout)
